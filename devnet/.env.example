# =============================================================================
# CGT Devnet Configuration
# =============================================================================
# Copy this file to .env and fill in the values after running op-deployer.

# -- L1 Connection (Sepolia) --------------------------------------------------
L1_RPC=https://your-sepolia-rpc
L1_BEACON=https://your-sepolia-beacon

# -- Funded Sepolia Keys ------------------------------------------------------
# Each role needs a separate funded Sepolia account.
SEQUENCER_KEY=0x...
BATCHER_KEY=0x...
PROPOSER_KEY=0x...

# -- Chain Config (from op-deployer output) ------------------------------------
L2_CHAIN_ID=

# -- L1 Contract Addresses (from op-deployer state.json) ----------------------
DISPUTE_GAME_FACTORY=0x...
BATCH_INBOX=0x...

# -- Images -------------------------------------------------------------------
# `us-docker.pkg.dev/.../op-reth:latest` is no longer published.
# Pinned, valid default from the same registry family as op-node/op-batcher/op-proposer.
OP_RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v1.10.0

# -- File Paths (relative to devnet/) -----------------------------------------
# Generate these with op-deployer inspect (see README).
GENESIS_FILE=./genesis.json
ROLLUP_FILE=./rollup.json
JWT_FILE=./jwt.hex
P2P_KEY_FILE=./p2p-key.txt

# -- L2 RPC Ports (defaults, change if ports conflict) ------------------------
L2_HTTP_PORT=9545
L2_WS_PORT=9546
L2_AUTH_PORT=9551
OP_NODE_RPC_PORT=7000
