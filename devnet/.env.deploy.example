# Required RPC endpoints
L1_RPC=https://your-sepolia-rpc
L1_BEACON=https://your-sepolia-beacon

# Required funded Sepolia private keys
DEPLOYER_KEY=0x...
SEQUENCER_KEY=0x...
BATCHER_KEY=0x...
PROPOSER_KEY=0x...

# Optional role overrides (default: deployer address)
# SUPERCHAIN_PROXY_ADMIN_OWNER=0x...
# PROTOCOL_VERSIONS_OWNER=0x...
# GUARDIAN_ADDRESS=0x...
# L1_PROXY_ADMIN_OWNER=0x...
# CHALLENGER_ADDRESS=0x...

# Optional deployment/runtime overrides
# OP_DEPLOYER_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-deployer:v0.6.0-rc.2
# OP_RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v1.10.0
# L2_CHAIN_ID_DEC=300000000000123
# L2_HTTP_PORT=19545
# L2_WS_PORT=19546
# L2_AUTH_PORT=19551
# OP_NODE_RPC_PORT=17000
# L2_AUTO_FUND_DEPLOYER=true
# L2_FAUCET_KEY=0x...                 # Defaults to the standard dev funded key when fundDevAccounts=true
# L2_DEPLOYER_MIN_WEI=200000000000000000
# L2_DEPLOYER_FUND_WEI=1000000000000000000
# FORGE_BROADCAST_TIMEOUT_SECONDS=180  # Timeout per forge broadcast attempt
# FORGE_BROADCAST_MAX_ATTEMPTS=3       # Retries for forge broadcasts
# FORGE_RETRY_SLEEP_SECONDS=8          # Delay between forge retries
# FORGE_CONTRACT_WAIT_ATTEMPTS=20      # Polls for deployed contract bytecode after broadcast

# Optional test token settings used by just deploy
# TOKEN_NAME="Devnet USD"
# TOKEN_SYMBOL="dUSD"
# TOKEN_DECIMALS=6
# TOKEN_INITIAL_SUPPLY_TOKENS=10000000
